{
  "expo": {
    "name": "Économat",
    "slug": "economat-mobile",
    "scheme": "economat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lecarre.economat",
      "infoPlist": {
        "NSCameraUsageDescription": "La caméra est utilisée pour scanner les QR codes des lots."
      }
    },
    "android": {
      "package": "com.lecarre.economat",
      "adaptiveIcon": {
        "backgroundColor": "#F6F5F2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-router",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "La caméra est utilisée pour scanner les QR codes des lots."
        }
      ]
    ]
  }
}
